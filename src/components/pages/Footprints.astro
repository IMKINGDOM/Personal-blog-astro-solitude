  // 完整 30 个种子城市
  var SEED = ['常州','泰州','杭州','台州','绍兴','嘉兴','上海','无锡','福州','泉州','厦门','镇江','金华','武汉','襄阳','孝感','宁波','苏州','南京','湖州','温州','广州','深圳','东莞','河内','成都','漳州','莆田','宜春','雅加达','徐州','包头'];

  function cityByName(name) {
    for (var i = 0; i < CITIES.length; i++) if (CITIES[i].n === name) return CITIES[i];
    return null;
  }

  var places = [], chart = null, lastTheme = '';

  function seedPlaces() {
    return SEED.map(cityByName).filter(Boolean).map(function (c) {
      return { n: c.n, e: c.e, c: c.c, p: c.p.slice() };
    });
  }

  try {
    var saved = localStorage.getItem(STORE_KEY);
    places = saved === null ? seedPlaces() : (JSON.parse(saved) || []);
    // 补齐种子中缺失的城市（新增城市只改 SEED 即可自动生效）
    var names = {};
    places.forEach(function (p) { names[p.n] = 1; });
    SEED.forEach(function (name) {
      if (!names[name]) {
        var c = cityByName(name);
        if (c) {
          places.push({ n: c.n, e: c.e, c: c.c, p: c.p.slice() });
          names[name] = 1;
        }
      }
    });
    localStorage.setItem(STORE_KEY, JSON.stringify(places));
  } catch (e) { places = seedPlaces(); }

  function save() { try { localStorage.setItem(STORE_KEY, JSON.stringify(places)); } catch (e) {} }

  function palette() {
    var cs = getComputedStyle(document.documentElement);
    var v = function (name, fallback) { return cs.getPropertyValue(name).trim() || fallback; };
    var dark = document.documentElement.getAttribute('data-theme') === 'dark';
    return {
      dark: dark,
      theme: v('--efu-theme', dark ? '#ffc848' : '#425aef'),
      font: v('--efu-fontcolor', dark ? '#f7f7fa' : '#363636'),
      second: v('--efu-secondtext', dark ? '#a1a2b8' : '#7f7f7f'),
      area: dark ? '#241d15' : '#e9e4d8',
      areaHover: dark ? '#3d311f' : '#d9d0bd',
      border: dark ? '#5a4a2e' : '#c4b9a4'
    };
  }

  // 中国城市 → 省份（用于统计，未列出的按城市名推测，可按需补充）
  var PROVINCE = {
    '常州':'江苏','无锡':'江苏','南京':'江苏','苏州':'江苏','镇江':'江苏','徐州':'江苏','扬州':'江苏','南通':'江苏','泰州':'江苏',
    '台州':'浙江','绍兴':'浙江','嘉兴':'浙江','金华':'浙江','宁波':'浙江','湖州':'浙江','温州':'浙江','杭州':'浙江',
    '上海':'上海','福州':'福建','泉州':'福建','厦门':'福建','漳州':'福建','莆田':'福建',
    '武汉':'湖北','襄阳':'湖北','孝感':'湖北','成都':'四川','宜春':'江西','广州':'广东','深圳':'广东','东莞':'广东',
    '包头':'内蒙古','北京':'北京','天津':'天津','重庆':'重庆','香港':'香港','澳门':'澳门'
  };

  function renderStats() {
    var countries = {}, provinces = {};
    places.forEach(function (p) {
      countries[p.c] = 1;
      if (p.c === '中国') {
        var prov = PROVINCE[p.n];
        if (prov) provinces[prov] = 1;
      }
    });
    var c = Object.keys(countries).length;
    var pr = Object.keys(provinces).length;
    var ci = places.length;
    document.getElementById('fp-stats').innerHTML =
      '<span><b>' + c + '</b>个国家</span><span><b>' + pr + '</b>个省</span><span><b>' + ci + '</b>座城</span>';
  }

  function renderList() {
    var list = document.getElementById('fp-list');
    var empty = document.getElementById('fp-empty');
    renderStats();
    list.innerHTML = '';
    if (!places.length) { empty.hidden = false; return; }
    empty.hidden = true;
    var frag = document.createDocumentFragment();
    places.forEach(function (p) {
      var li = document.createElement('li');
      li.className = 'fp-chip';
      li.textContent = p.c + (COUNTRY_EN[p.c] || '') + '·' + p.n + p.e;
      li.title = p.n + ' · ' + p.c;
      frag.appendChild(li);
    });
    list.appendChild(frag);
  }

  function buildSeries(pulse, pal) {
    var series = [
      {
        name: '常州辐射线', type: 'lines', coordinateSystem: 'geo', polyline: false, zlevel: 2,
        lineStyle: { color: pal.theme, width: .8, opacity: pal.dark ? .38 : .3, type: 'dashed', curveness: .08 },
        effect: {
          show: true, period: 4, trailLength: .5, symbol: 'circle', symbolSize: 3,
          color: pal.dark ? '#fff1bd' : pal.theme, loop: true
        },
        silent: true,
        data: places.map(function (p) { return { coords: [HOME.p, p.p] }; })
      },
      {
        name: '足迹', type: 'effectScatter', coordinateSystem: 'geo', zlevel: 3,
        rippleEffect: { brushType: 'stroke', scale: 2.6, period: 3.2 },
        symbolSize: 4,
        itemStyle: { color: pal.theme, shadowBlur: 7, shadowColor: pal.theme },
        label: {
          show: true, formatter: '{b}', position: 'right', distance: 7,
          color: pal.dark ? '#ffe9b8' : '#4a3a12', fontSize: 11,
          textShadowBlur: 4, textShadowColor: pal.dark ? '#000' : '#fff'
        },
        emphasis: { scale: 1.5, label: { show: true, fontWeight: 'bold', color: pal.font } },
        data: places.map(function (p) { return { name: p.n, value: [p.p[0], p.p[1]], city: p }; })
      }
    ];
    if (pulse) {
      series.push({
        name: '点亮冲击波', type: 'effectScatter', coordinateSystem: 'geo', zlevel: 4,
        rippleEffect: { brushType: 'stroke', scale: 5, period: 1.6 },
        symbolSize: 7, silent: true,
        itemStyle: { color: pal.dark ? '#ffffff' : pal.theme, shadowBlur: 14, shadowColor: pal.theme },
        label: { show: false }, data: [{ name: '', value: pulse }]
      });
    }
    return series;
  }

  function renderMap(pulse) {
    if (!chart) return;
    var pal = palette();
    lastTheme = pal.dark ? 'dark' : 'light';
    chart.setOption({
      backgroundColor: 'transparent',
      tooltip: {
        trigger: 'item',
        backgroundColor: pal.dark ? 'rgba(20,16,12,.94)' : 'rgba(255,255,255,.96)',
        borderColor: pal.theme,
        textStyle: { color: pal.font, fontSize: 12 },
        formatter: function (param) {
          var d = param.data && param.data.city;
          if (!d) return '';
          return '<span style="color:' + pal.theme + ';font-weight:700;">' + d.n + '</span><br>'
            + '<span style="color:' + pal.font + ';">' + d.c + ' · ' + d.e + '</span><br>'
            + '<span style="color:' + pal.second + ';font-size:11px;">' + d.p[1].toFixed(2) + '°, ' + d.p[0].toFixed(2) + '°</span>';
        }
      },
      geo: {
        map: 'world', roam: true, zoom: 16, center: [121.2, 30.5], scaleLimit: { min: 1, max: 40 },
        itemStyle: { areaColor: pal.area, borderColor: pal.border, borderWidth: .7 },
        emphasis: { itemStyle: { areaColor: pal.areaHover }, label: { show: false } },
        label: { show: false }, silent: false
      },
      series: buildSeries(pulse, pal)
    }, { notMerge: true });
  }

  function renderAll() { renderList(); renderMap(null); }

  function boot() {
    // 首屏资源可能尚未就绪（world.js 体积大、脚本时序），轮询等待而非一次性判断
    if (!window.echarts || !window.WORLD_GEOJSON) {
      var waited = 0, timer = setInterval(function () {
        waited += 100;
        if (window.echarts && window.WORLD_GEOJSON) {
          clearInterval(timer);
          boot();
        } else if (waited >= 8000) {
          clearInterval(timer);
          document.getElementById('fp-map-tip').textContent = '地图资源未加载，请刷新重试。';
        }
      }, 100);
      return;
    }
    echarts.registerMap('world', window.WORLD_GEOJSON);
    chart = echarts.init(document.getElementById('fp-map'), null, { renderer: 'canvas' });
    document.getElementById('fp-map-tip').hidden = true;
    renderAll();

    var resizeTimer = null;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () { if (chart) chart.resize(); }, 120);
    });

    var themeTimer = null;
    function onThemeChange() {
      clearTimeout(themeTimer);
      themeTimer = setTimeout(function () {
        var now = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
        if (now !== lastTheme) { lastTheme = now; renderMap(null); }
      }, 40);
    }
    document.addEventListener('solitude:themeChange', onThemeChange);
    if (window.MutationObserver) {
      new MutationObserver(onThemeChange).observe(document.documentElement, {
        attributes: true, attributeFilter: ['data-theme']
      });
    }

  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
