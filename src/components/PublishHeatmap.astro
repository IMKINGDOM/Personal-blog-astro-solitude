---
import type { Post } from '../lib/content';
interface Props { posts: Post[] }
const { posts } = Astro.props;

function key(d: Date): string {
  return d.getFullYear() + '-' +
    String(d.getMonth() + 1).padStart(2, '0') + '-' +
    String(d.getDate()).padStart(2, '0');
}

const today = new Date();
today.setHours(0, 0, 0, 0);
const year = today.getFullYear();
const month = today.getMonth();
const daysInMonth = new Date(year, month + 1, 0).getDate();
// 周一起始：getDay() 周日=0 → 偏移 6；周一=1 → 偏移 0
const leading = (new Date(year, month, 1).getDay() + 6) % 7;

const counts = new Map<string, number>();
let total = 0;
for (const post of posts) {
  const d = new Date(post.data.date as unknown as string);
  if (isNaN(+d) || d.getFullYear() !== year || d.getMonth() !== month) continue;
  const k = key(d);
  counts.set(k, (counts.get(k) ?? 0) + 1);
  total++;
}

type Cell = { key: string; n: number; level: number } | null;
const cells: Cell[] = [];
for (let i = 0; i < leading; i++) cells.push(null);
for (let day = 1; day <= daysInMonth; day++) {
  const k = key(new Date(year, month, day));
  const n = counts.get(k) ?? 0;
  cells.push({ key: k, n, level: n === 0 ? 0 : Math.min(4, n) });
}
const monthLabel = `${year}年${month + 1}月`;
---

<div class="card-widget card-heatmap capsule-sheen tw:relative tw:[#aside-content_&]:overflow-hidden">
  <div class="hm-head">
    <span class="hm-title">发布记录</span>
    <span class="hm-sub">{monthLabel} · {total} 篇</span>
  </div>
  <div class="hm-grid" aria-label={`${monthLabel}每日发布篇数`}>
    {cells.map((c) => (
      c
        ? <i class={`hm-cell lv-${c.level}`} title={`${c.key} · ${c.n} 篇`} />
        : <i class="hm-cell hm-empty" aria-hidden="true" />
    ))}
  </div>
  <div class="hm-legend">
    <span>少</span>
    {[0, 1, 2, 3, 4].map((l) => <i class={`hm-cell lv-${l}`} />)}
    <span>多</span>
  </div>
</div>

<style>
  .card-heatmap {
    border-radius: var(--radius);
    border: var(--style-border);
    background: linear-gradient(135deg,
      color-mix(in srgb, var(--efu-card-bg) 94%, #b18a58 6%),
      var(--efu-card-bg));
    box-shadow: var(--efu-shadow-black);
    padding: 14px 16px 12px;
  }
  .hm-head {
    display: flex; align-items: baseline; justify-content: space-between;
    margin-bottom: 13px; gap: 8px;
  }
  .hm-title {
    font-size: 15px; font-weight: 700; color: var(--efu-fontcolor);
  }
  .hm-sub {
    font-size: 12px; color: var(--efu-secondtext); white-space: nowrap;
  }
  .hm-grid {
    display: grid; grid-template-columns: repeat(7, 1fr);
    gap: 5px;
    /* 方格缩小到原先 60%：收紧整块宽度并左对齐 */
    width: 60%;
  }
  .hm-cell {
    display: block; aspect-ratio: 1 / 1; width: 100%;
    border-radius: 3px; background: rgba(128, 128, 128, .18);
  }
  .hm-cell.hm-empty { background: transparent; }
  .hm-cell.lv-1 { background: #9fb4d8; }
  .hm-cell.lv-2 { background: #7e9bc9; }
  .hm-cell.lv-3 { background: #5477b6; }
  .hm-cell.lv-4 { background: #2f5295; }
  .hm-legend {
    display: flex; align-items: center; justify-content: flex-end;
    gap: 4px; margin-top: 12px;
    font-size: 11px; color: var(--efu-secondtext);
  }
  .hm-legend .hm-cell { width: 10px; height: 10px; aspect-ratio: auto; }
  @media (max-width: 1199px) {
    .card-heatmap { display: none; }
  }
</style>
