const BASE = 'https://cdn.jsdelivr.net/gh/IMKINGDOM/Music-Storage@main/';
---

<div id="mini-music" class="mm-root capsule-sheen" transition:persist="mini-music">
  <div id="mm-bar" class="mm-bar" role="group" aria-label="音乐播放器">
    <span class="mm-disc" id="mm-disc" aria-hidden="true"><span class="mm-disc-hole"></span></span>
    <span class="mm-info">
      <span class="mm-music"><span id="mm-title" class="mm-title">加载中…</span></span>
      <span id="mm-lyric" class="mm-lyric">♪</span>
    </span>
    <span class="mm-ctrl" id="mm-ctrl">
      <button id="mm-prev" class="mm-control-btn" type="button" aria-label="上一首"><i class="solitude fas fa-backward-step"></i></button>
      <button id="mm-pause" class="mm-control-btn" type="button" aria-label="暂停"><i class="solitude fas fa-pause"></i></button>
      <button id="mm-play" class="mm-control-btn" type="button" aria-label="播放"><i class="solitude fas fa-play"></i></button>
      <button id="mm-next" class="mm-control-btn" type="button" aria-label="下一首"><i class="solitude fas fa-forward-step"></i></button>
    </span>
    <span class="mm-bar-track" aria-hidden="true"><span id="mm-progress-fill" class="mm-played"></span></span>
  </div>
</div>

<script is:inline define:vars={{ tracks, BASE }}>
(function () {
  var root = document.getElementById('mini-music');
  if (!root || root.dataset.mmInit) return;
  root.dataset.mmInit = '1';

  var bar = document.getElementById('mm-bar');
  var titleEl = document.getElementById('mm-title');
  var lyricEl = document.getElementById('mm-lyric');
  var progress = document.getElementById('mm-progress-fill');
  var pauseBtn = document.getElementById('mm-pause');
  var playBtn = document.getElementById('mm-play');
  var audio = new Audio();
  audio.preload = 'metadata';
  audio.volume = 0.8;

  var order = tracks.map(function (_, i) { return i; });
  for (var j = order.length - 1; j > 0; j--) {
    var k = Math.floor(Math.random() * (j + 1));
    var tmp = order[j]; order[j] = order[k]; order[k] = tmp;
  }
  var pos = 0, lastLine = -1;

  function showLyric(time, force) {
    var lrc = tracks[order[pos]].lrc;
    var cur = 0;
    for (var i = 0; i < lrc.length; i++) { if (lrc[i][0] <= time) cur = i; else break; }
    if (cur === lastLine && !force) return;
    lastLine = cur;
    lyricEl.textContent = lrc[cur] ? lrc[cur][1] : '♪';
  }

  var pendingStart = null;
  function tryPlay() {
    return audio.play().catch(function () {
      if (pendingStart) return;
      pendingStart = function () {
        audio.play().catch(function () {});
        document.removeEventListener('pointerdown', pendingStart);
        document.removeEventListener('keydown', pendingStart);
        pendingStart = null;
      };
      document.addEventListener('pointerdown', pendingStart);
      document.addEventListener('keydown', pendingStart);
    });
  }
  function syncBtn() {
    var playing = !audio.paused;
    pauseBtn.style.display = playing ? '' : 'none';
    playBtn.style.display = playing ? 'none' : '';
    root.classList.toggle('is-playing', playing);
  }
  function load(n, autoplay) {
    pos = (n + order.length) % order.length;
    var track = tracks[order[pos]];
    audio.src = BASE + track.file;
    titleEl.textContent = track.name + ' - ' + track.artist;
    progress.style.width = '0%';
    showLyric(0, true);
    if (autoplay !== false) tryPlay();
  }

  audio.addEventListener('timeupdate', function () {
    showLyric(audio.currentTime);
    if (audio.duration) progress.style.width = (audio.currentTime / audio.duration * 100).toFixed(2) + '%';
  });
  audio.addEventListener('ended', function () {
    if (audio.duration && audio.currentTime >= audio.duration - 1.5) load(pos + 1);
  });
  audio.addEventListener('play', syncBtn);
  audio.addEventListener('pause', function () { setTimeout(syncBtn, 120); });

  pauseBtn.addEventListener('click', function (e) { e.stopPropagation(); if (!pendingStart) audio.pause(); });
  playBtn.addEventListener('click', function (e) { e.stopPropagation(); tryPlay(); });
  document.getElementById('mm-next').addEventListener('click', function (e) { e.stopPropagation(); load(pos + 1); });
  document.getElementById('mm-prev').addEventListener('click', function (e) { e.stopPropagation(); load(pos - 1); });

  load(0);
})();
</script>

<style>
  .mm-root {
    position: fixed; left: 20px; bottom: 20px; z-index: 20;
    font-family: inherit;
    --efu-music: var(--efu-theme);
  }
  .mm-bar {
    display: flex; align-items: center;
    position: relative;
    height: 46px; min-height: 46px; max-height: 46px;
    padding: 8px 16px 8px 8px;
    border-radius: 60px;
    background: var(--efu-card-bg);
    border: var(--style-border-always);
    box-shadow: var(--efu-shadow-border);
    overflow: hidden; cursor: pointer;
    transition: width .4s cubic-bezier(.34, 1.56, .64, 1), box-shadow .3s;
    width: 122px;
  }
  .mm-root:hover .mm-bar { width: 430px; max-width: calc(100vw - 40px); }
  .mm-disc {
    position: relative; z-index: 1;
    flex: 0 0 30px; width: 30px; height: 30px; margin-right: 8px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #6b5844, #1c1714 65%, #0d0b0a);
    border: var(--style-border-always);
    border-color: var(--efu-card-bg);
    box-shadow: 0 0 14px var(--efu-card-bg);
    animation: capsuleCoverSpin 24s linear infinite;
  }
  .mm-root:not(.is-playing) .mm-disc { animation-play-state: paused; }
  @keyframes capsuleCoverSpin { to { transform: rotate(360deg); } }
  .mm-disc-hole {
    position: absolute; left: 50%; top: 50%;
    width: 8px; height: 8px; margin: -4px 0 0 -4px;
    border-radius: 50%; background: var(--efu-theme);
  }
  .mm-info {
    display: flex; flex-direction: column; justify-content: center;
    flex: 1 1 auto; min-width: 0; height: 30px;
    position: relative; z-index: 1;
  }
  .mm-music {
    display: block; height: 16px; min-height: 16px;
    overflow: hidden; line-height: 16px;
  }
  .mm-title {
    display: block; max-width: 120px; white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis;
    color: var(--efu-fontcolor); font-size: 13px; font-weight: 700;
  }
  .mm-lyric {
    display: block; max-width: 0; height: 14px; min-height: 14px;
    margin: 0; padding: 0; opacity: 0; overflow: hidden;
    color: var(--efu-fontcolor); font-size: 11px; line-height: 14px;
    white-space: nowrap; text-overflow: ellipsis;
    transition: max-width .28s, margin .28s, opacity .28s;
  }
  .mm-root:hover .mm-lyric { max-width: 200px; margin-top: 1px; opacity: .55; }
  .mm-ctrl {
    display: flex; align-items: center; gap: 2px;
    flex: 0 0 auto; margin-left: 0; position: relative; z-index: 4;
    opacity: 0; max-width: 0; overflow: hidden;
    transition: opacity .28s, max-width .28s, margin .28s;
  }
  .mm-root:hover .mm-ctrl { opacity: 1; max-width: 120px; margin-left: 10px; }
  .mm-control-btn {
    display: flex; align-items: center; justify-content: center;
    width: 24px; height: 30px; padding: 0;
    color: var(--efu-fontcolor); background: none; border: 0;
    font-size: 14px; line-height: 30px; opacity: .8; cursor: pointer;
    transition: opacity .2s, transform .2s;
  }
  .mm-control-btn:hover { opacity: 1; }
  .mm-control-btn:active { transform: scale(.85); }
  .mm-bar-track {
    position: absolute; left: 16px; right: 16px; bottom: 6px;
    height: 3px; border-radius: 12px;
    background: var(--efu-gray, rgba(128,128,128,.35));
    overflow: hidden; z-index: 2;
  }
  .mm-played {
    display: block; height: 100%; width: 0; border-radius: 12px;
    background: var(--efu-theme); opacity: .9;
  }
  @media (max-width: 600px) {
    .mm-root { left: 12px; bottom: 12px; }
    .mm-root:hover .mm-bar { width: calc(100vw - 24px); }
  }
</style>
