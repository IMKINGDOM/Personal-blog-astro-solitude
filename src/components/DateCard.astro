---
// 侧边栏日期卡片：周次 / 大号日期 / 年内天数 / 干支农历 + 当月日历网格
---

<div class="card-widget card-date tw:relative tw:[#aside-content_&]:overflow-hidden" id="card-widget-date">
  <span class="card-glow-light" aria-hidden="true"></span>
  <div class="dc-body">
    <div class="dc-left">
      <div class="dc-week" id="dc-week">—</div>
      <div class="dc-day" id="dc-day">—</div>
      <div class="dc-solar" id="dc-solar">—</div>
      <div class="dc-lunar" id="dc-lunar">—</div>
    </div>
    <div class="dc-right">
      <div class="dc-cal" id="dc-cal" aria-label="本月日历"></div>
    </div>
  </div>
</div>

<script is:inline>
(function () {
  // ClientRouter(SPA) 换页后本脚本不会重跑，必须监听 astro:page-load 才能重新初始化新 DOM。
  function initDateCard() {
  var root = document.getElementById('card-widget-date');
  if (!root || root.dataset.dcInit) return;
  root.dataset.dcInit = '1';

  var weekEl = document.getElementById('dc-week');
  var dayEl = document.getElementById('dc-day');
  var solarEl = document.getElementById('dc-solar');
  var lunarEl = document.getElementById('dc-lunar');
  var calEl = document.getElementById('dc-cal');

  var now = new Date();
  var y = now.getFullYear(), m = now.getMonth(), day = now.getDate();

  var weekNames = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
  var weekStr = weekNames[now.getDay()];

  function isoWeek(d) {
    var t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
    var n = t.getUTCDay() || 7;
    t.setUTCDate(t.getUTCDate() + 4 - n);
    var start = new Date(Date.UTC(t.getUTCFullYear(), 0, 1));
    return Math.ceil((((t - start) / 86400000) + 1) / 7);
  }

  function dayOfYear(d) {
    return Math.floor((d - new Date(d.getFullYear(), 0, 0)) / 86400000);
  }

  var GAN = '甲乙丙丁戊己庚辛壬癸';
  var ZHI = '子丑寅卯辰巳午未申酉戌亥';
  var ANIMAL = '鼠牛虎兔龙蛇马羊猴鸡狗猪';
  function ganzhi(d) {
    var k = ((d.getFullYear() - 4) % 60 + 60) % 60;
    return GAN[k % 10] + ZHI[k % 12] + ANIMAL[k % 12];
  }

  function cnDay(n) {
    var c = ['', '一', '二', '三', '四', '五', '六', '七', '八', '九'];
    if (n <= 10) return '初' + c[n];
    if (n < 20) return '十' + c[n - 10];
    if (n === 20) return '二十';
    if (n < 30) return '二十' + c[n - 20];
    return '三十';
  }
  function lunarDate(d) {
    try {
      var parts = new Intl.DateTimeFormat('zh-CN-u-ca-chinese', {
        month: 'long', day: 'numeric'
      }).formatToParts(d);
      var mon = '', dd = '';
      for (var i = 0; i < parts.length; i++) {
        if (parts[i].type === 'month') mon = parts[i].value;
        if (parts[i].type === 'day') dd = cnDay(parseInt(parts[i].value, 10));
      }
      return mon + dd;
    } catch (e) { return ''; }
  }

  var solarMonth = (m + 1) + '月';
  weekEl.textContent = '第' + isoWeek(now) + '周  ' + weekStr;
  dayEl.textContent = ('0' + day).slice(-2);
  solarEl.textContent = y + '年' + solarMonth + '  第' + dayOfYear(now) + '天';
  var ld = lunarDate(now);
  lunarEl.textContent = ganzhi(now) + '年' + (ld ? '  ' + ld : '');

  // 当月日历：周日起始，前置空格补齐；今天主题色圆形高亮
  var first = new Date(y, m, 1).getDay();
  var total = new Date(y, m + 1, 0).getDate();
  var html = '';
  for (var b = 0; b < first; b++) html += '<i></i>';
  for (var n = 1; n <= total; n++) {
    html += '<i' + (n === day ? ' class="now"' : '') + '>' + n + '</i>';
  }
  calEl.innerHTML = html;

  // 跨零点自动刷新（极少数场景）
  var timer = setInterval(function () {
    var d = new Date();
    if (d.getDate() !== day || d.getMonth() !== m) {
      clearInterval(timer);
      delete root.dataset.dcInit;
      location.reload();
    }
  }, 60000);
  }

  // 首次加载 + 每次 ClientRouter 换页都初始化；定时器随页面切换自动作废。
  initDateCard();
  document.addEventListener('astro:page-load', initDateCard);
})();
</script>

<style>
  .card-date {
    position: relative;
    border-radius: var(--radius);
    background: linear-gradient(135deg,
      color-mix(in srgb, var(--efu-card-bg) 94%, #b18a58 6%),
      var(--efu-card-bg));
    border: var(--style-border);
    box-shadow: var(--efu-shadow-black);
    --card-glow-x: 50%;
    --card-glow-y: 50%;
    --card-glow-opacity: 0;
  }
  .card-date > .card-glow-light {
    position: absolute; inset: 0; z-index: 0;
    border-radius: inherit; pointer-events: none;
    opacity: var(--card-glow-opacity);
    background: radial-gradient(circle 200px at var(--card-glow-x) var(--card-glow-y),
      rgba(255,255,255,.95) 0%, rgba(255,255,255,.55) 28%,
      rgba(255,255,255,.16) 55%, rgba(255,255,255,0) 82%);
    transition: opacity .12s linear;
  }
  .card-date::after {
    position: absolute; inset: 0; z-index: 2; content: '';
    border-radius: inherit; pointer-events: none; padding: 2px;
    opacity: var(--card-glow-opacity);
    background: radial-gradient(circle 150px at var(--card-glow-x) var(--card-glow-y),
      rgba(255,255,255,1) 0%, rgba(255,255,255,.6) 40%, rgba(255,255,255,0) 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
  }
  .dc-body {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: auto 1fr;
    align-items: center; gap: 10px;
    padding: 14px;
  }
  .dc-left { min-width: 100px; }
  .dc-week {
    font-size: 13px; font-weight: 600; letter-spacing: .5px;
    color: var(--efu-secondtext);
  }
  .dc-day {
    font-family: var(--efu-font-family);
    font-size: 52px; font-weight: 700; line-height: 1.08;
    color: var(--efu-theme);
    text-shadow: 0 2px 10px color-mix(in srgb, var(--efu-theme) 28%, transparent);
  }
  .dc-solar, .dc-lunar {
    font-size: 11px; line-height: 1.65; white-space: nowrap;
  }
  .dc-solar { color: var(--efu-fontcolor); opacity: .9; }
  .dc-lunar { color: var(--efu-secondtext); }
  .dc-cal {
    display: grid; grid-template-columns: repeat(7, 1fr);
    gap: 3px 0; text-align: center;
  }
  .dc-cal :global(i) {
    font-style: normal; font-size: 10px; line-height: 20px;
    width: 100%; height: 20px; border-radius: 50%;
    color: var(--efu-secondtext);
  }
  .dc-cal :global(i.now) {
    background: var(--efu-theme);
    color: var(--efu-background);
    font-weight: 700;
    box-shadow: 0 0 10px color-mix(in srgb, var(--efu-theme) 45%, transparent);
  }
  @media (max-width: 1199px) {
    .card-date { display: none; }
  }
</style>
