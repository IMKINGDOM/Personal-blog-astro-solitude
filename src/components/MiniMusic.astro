const BASE = 'https://cdn.jsdelivr.net/gh/IMKINGDOM/Music-Storage@main/';
---

<div id="mini-music" class="mm-root" transition:persist="mini-music">
  <div id="mm-bar" class="mm-bar" role="group" aria-label="音乐播放器">
    <div class="mm-progress" aria-hidden="true"><span id="mm-progress-fill"></span></div>
    <span class="mm-disc" aria-hidden="true"><span class="mm-disc-hole"></span></span>
    <span class="mm-marquee">
      <span class="mm-scroll" id="mm-scroll">
        <span class="mm-line" id="mm-line-a">加载中…</span>
        <span class="mm-line" id="mm-line-b" aria-hidden="true">加载中…</span>
      </span>
    </span>
    <span class="mm-ctrl">
      <button id="mm-prev" class="mm-icon" type="button" aria-label="上一首"><i class="solitude fas fa-backward-step"></i></button>
      <button id="mm-play" class="mm-icon" type="button" aria-label="播放/暂停"><i class="solitude fas fa-pause"></i></button>
      <button id="mm-next" class="mm-icon" type="button" aria-label="下一首"><i class="solitude fas fa-forward-step"></i></button>
    </span>
  </div>
</div>

<script is:inline define:vars={{ tracks, BASE }}>
(function () {
  var root = document.getElementById('mini-music');
  if (!root || root.dataset.mmInit) return;
  root.dataset.mmInit = '1';

  var bar = document.getElementById('mm-bar');
  var lineA = document.getElementById('mm-line-a');
  var lineB = document.getElementById('mm-line-b');
  var progress = document.getElementById('mm-progress-fill');
  var playBtn = document.getElementById('mm-play');
  var audio = new Audio();
  audio.preload = 'metadata';
  audio.volume = 0.7;

  var order = tracks.map(function (_, i) { return i; });
  for (var j = order.length - 1; j > 0; j--) {
    var k = Math.floor(Math.random() * (j + 1));
    var tmp = order[j]; order[j] = order[k]; order[k] = tmp;
  }
  var pos = 0;
  var lastLine = -1;

  function currentLyrics() { return tracks[order[pos]].lrc; }
  function showLyric(time, force) {
    var lrc = currentLyrics();
    var cur = 0;
    for (var i = 0; i < lrc.length; i++) { if (lrc[i][0] <= time) cur = i; else break; }
    if (cur === lastLine && !force) return;
    lastLine = cur;
    var track = tracks[order[pos]];
    var text = track.name + ' · ' + track.artist + '　' + (lrc[cur] ? lrc[cur][1] : '♪');
    lineA.textContent = text;
    lineB.textContent = text;
  }

  var pendingStart = null;
  function tryPlay() {
    return audio.play().catch(function () {
      if (pendingStart) return;
      pendingStart = function () {
        audio.play().catch(function () {});
        document.removeEventListener('pointerdown', pendingStart);
        document.removeEventListener('keydown', pendingStart);
        pendingStart = null;
      };
      document.addEventListener('pointerdown', pendingStart);
      document.addEventListener('keydown', pendingStart);
    });
  }
  function load(n, autoplay) {
    pos = (n + order.length) % order.length;
    var track = tracks[order[pos]];
    audio.src = BASE + track.file;
    progress.style.width = '0%';
    showLyric(0, true);
    if (autoplay !== false) tryPlay();
  }

  audio.addEventListener('timeupdate', function () {
    showLyric(audio.currentTime);
    if (audio.duration) progress.style.width = (audio.currentTime / audio.duration * 100).toFixed(2) + '%';
  });
  audio.addEventListener('ended', function () {
    if (audio.duration && audio.currentTime >= audio.duration - 1.5) load(pos + 1);
  });
  audio.addEventListener('play', function () {
    playBtn.innerHTML = '<i class="solitude fas fa-pause"></i>';
    root.classList.add('is-playing');
  });
  audio.addEventListener('pause', function () {
    setTimeout(function () {
      if (audio.paused) {
        playBtn.innerHTML = '<i class="solitude fas fa-play"></i>';
        root.classList.remove('is-playing');
      }
    }, 120);
  });

  playBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    if (audio.paused) tryPlay();
    else if (!pendingStart) audio.pause();
  });
  document.getElementById('mm-next').addEventListener('click', function (e) { e.stopPropagation(); load(pos + 1); });
  document.getElementById('mm-prev').addEventListener('click', function (e) { e.stopPropagation(); load(pos - 1); });

  // 拖拽移动（避开控制按钮）
  var down = false, sx = 0, sy = 0, ox = 0, oy = 0;
  bar.addEventListener('pointerdown', function (e) {
    if (e.target.closest('.mm-icon')) return;
    down = true;
    sx = e.clientX; sy = e.clientY;
    var r = root.getBoundingClientRect();
    ox = r.left; oy = r.top;
    root.style.left = ox + 'px'; root.style.top = oy + 'px';
    root.style.bottom = 'auto';
    bar.setPointerCapture(e.pointerId);
  });
  bar.addEventListener('pointermove', function (e) {
    if (!down) return;
    root.style.left = Math.max(0, Math.min(window.innerWidth - root.offsetWidth, ox + e.clientX - sx)) + 'px';
    root.style.top = Math.max(0, Math.min(window.innerHeight - root.offsetHeight, oy + e.clientY - sy)) + 'px';
  });
  bar.addEventListener('pointerup', function (e) {
    down = false;
    bar.releasePointerCapture(e.pointerId);
  });

  load(0);
})();
</script>

<style>
  .mm-root {
    position: fixed; left: 18px; bottom: 18px; z-index: 9000;
    font-family: inherit; color: #e8c98a;
  }
  .mm-bar {
    display: flex; align-items: center;
    position: relative;
    width: 480px; max-width: calc(100vw - 36px);
    height: 46px; padding: 0 9px 0 4px;
    border-radius: 999px;
    border: 1px solid rgba(232, 201, 138, .38);
    background: linear-gradient(180deg, rgba(40, 34, 29, .94), rgba(21, 18, 16, .96));
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    backdrop-filter: blur(16px) saturate(1.3);
    box-shadow: 0 4px 20px rgba(0,0,0,.34), inset 0 1px 0 rgba(255,255,255,.06);
    overflow: hidden; cursor: grab; touch-action: none;
    transition: box-shadow .25s ease, border-color .25s ease;
  }
  .mm-bar:hover {
    border-color: rgba(232, 201, 138, .7);
    box-shadow: 0 4px 22px rgba(0,0,0,.42), 0 0 20px rgba(232,201,138,.18);
  }
  .mm-bar:active { cursor: grabbing; }
  .mm-progress {
    position: absolute; top: 0; left: 16px; right: 16px; height: 2px;
    background: rgba(255,255,255,.14); border-radius: 2px;
    overflow: hidden; z-index: 2;
  }
  .mm-progress span {
    display: block; height: 100%; width: 0;
    background: linear-gradient(90deg, #f7b955, #ff5f4d);
    transition: width .25s linear;
  }
  .mm-disc {
    flex: 0 0 38px; width: 38px; height: 38px; margin-right: 10px;
    border-radius: 50%; position: relative; display: block;
    background: radial-gradient(circle at 34% 28%, #6b5844, #241d19 62%, #100d0c);
    border: 1px solid rgba(232, 201, 138, .34);
    box-shadow: inset 0 0 9px rgba(0,0,0,.72);
  }
  .mm-disc::before {
    content: ''; position: absolute; inset: 3px; border-radius: 50%;
    background: repeating-radial-gradient(circle,
      transparent 0 2px, rgba(255, 220, 170, .085) 2px 3px);
  }
  .mm-disc-hole {
    position: absolute; left: 50%; top: 50%;
    width: 9px; height: 9px; margin: -4.5px 0 0 -4.5px;
    border-radius: 50%; background: #e8c98a;
    box-shadow: 0 0 5px rgba(0,0,0,.7);
  }
  .mm-root.is-playing .mm-disc { animation: mm-spin 5s linear infinite; }
  @keyframes mm-spin { to { transform: rotate(360deg); } }
  .mm-marquee {
    flex: 1 1 auto; min-width: 0; overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .mm-scroll {
    display: flex; width: max-content;
    animation: mm-marquee 20s linear infinite;
  }
  .mm-root:not(.is-playing) .mm-scroll { animation-play-state: paused; }
  .mm-line {
    padding-right: 44px; white-space: nowrap;
    font-size: 13px; font-weight: 500; color: #e8c98a;
    text-shadow: 0 1px 2px rgba(0,0,0,.5);
  }
  @keyframes mm-marquee { to { transform: translateX(-50%); } }
  .mm-ctrl {
    display: flex; align-items: center; gap: 1px;
    flex: 0 0 auto; margin-left: 6px;
  }
  .mm-icon {
    width: 27px; height: 27px; flex: 0 0 27px;
    border: none; border-radius: 7px; cursor: pointer;
    background: transparent; color: #e8c98a; font-size: 13px;
    transition: background .2s ease, color .2s ease;
  }
  .mm-icon:hover {
    background: rgba(232, 201, 138, .15);
    color: #fff2d0;
  }
  @media (max-width: 600px) {
    .mm-root { left: 12px; bottom: 12px; }
    .mm-bar { width: calc(100vw - 24px); height: 42px; }
    .mm-disc { flex-basis: 34px; width: 34px; height: 34px; }
    .mm-line { font-size: 12px; }
    .mm-icon { width: 24px; height: 24px; flex-basis: 24px; }
  }
</style>
