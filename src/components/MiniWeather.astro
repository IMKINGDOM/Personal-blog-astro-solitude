---
// 左下角天气胶囊：浏览器定位 + 公开天气 API，本地缓存，失败降级到常州
---

<div id="mini-weather" class="mw-root" transition:persist="mini-weather" data-weather="night">
  <div class="weather-capsule" id="mw-capsule" title="你所在位置的实时天气 · 数据来自 Open-Meteo">
    <i class="weather-icon fas fa-moon mw-icon" id="mw-icon" aria-hidden="true"></i>
    <span class="weather-summary" id="mw-summary">定位中…</span>
  </div>
</div>

<script is:inline>
(function () {
  var root = document.getElementById('mini-weather');
  if (!root || root.dataset.mwInit) return;
  root.dataset.mwInit = '1';

  var iconEl = document.getElementById('mw-icon');
  var summaryEl = document.getElementById('mw-summary');
  var KEY = 'step-mini-weather-v1';
  var TTL = 30 * 60 * 1000;
  var FALLBACK = { lat: 31.81, lon: 119.97, label: '常州' }; // 用户所在地，定位失败时兜底

  var TABLE = [
    { code: [0], icon: 'fa-sun', night: 'fa-moon', text: '晴', tone: 'sun' },
    { code: [1, 2], icon: 'fa-cloud-sun', night: 'fa-cloud-moon', text: '多云', tone: 'cloud' },
    { code: [3], icon: 'fa-cloud', night: 'fa-cloud', text: '阴', tone: 'cloud' },
    { code: [45, 48], icon: 'fa-smog', night: 'fa-smog', text: '雾', tone: 'fog' },
    { code: [51, 53, 55, 56, 57], icon: 'fa-cloud-rain', night: 'fa-cloud-rain', text: '小雨', tone: 'rain' },
    { code: [61, 63, 66, 67], icon: 'fa-cloud-rain', night: 'fa-cloud-rain', text: '雨', tone: 'rain' },
    { code: [65, 80, 81, 82], icon: 'fa-cloud-showers-heavy', night: 'fa-cloud-showers-heavy', text: '阵雨', tone: 'rain' },
    { code: [71, 73, 75, 77, 85, 86], icon: 'fa-snowflake', night: 'fa-snowflake', text: '雪', tone: 'snow' },
    { code: [95, 96, 99], icon: 'fa-bolt', night: 'fa-bolt', text: '雷雨', tone: 'rain' }
  ];
  function match(code, isDay) {
    for (var i = 0; i < TABLE.length; i++) {
      if (TABLE[i].code.indexOf(code) !== -1) {
        return {
          icon: isDay ? TABLE[i].icon : TABLE[i].night,
          text: TABLE[i].text,
          tone: TABLE[i].tone
        };
      }
    }
    return { icon: 'fa-cloud', text: '多云', tone: 'cloud' };
  }
  function apply(data) {
    iconEl.className = 'weather-icon fas ' + data.icon;
    summaryEl.textContent = Math.round(data.temp) + '°C ' + data.text;
    root.dataset.weather = data.tone;
    root.title = data.city + ' · 数据来自 Open-Meteo';
  }
  function save(data) {
    try { localStorage.setItem(KEY, JSON.stringify({ t: Date.now(), data: data })); } catch (e) {}
  }

  // 先用缓存立刻出图，再视情况刷新
  var cached = null;
  try { cached = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) {}
  if (cached && cached.data && Date.now() - cached.t < TTL) {
    apply(cached.data);
    return;
  }

  function request(lat, lon, city) {
    var api = 'https://api.open-meteo.com/v1/forecast?latitude=' + lat +
      '&longitude=' + lon +
      '&current=temperature_2m,weather_code,is_day&timezone=auto';
    fetch(api, { mode: 'cors' })
      .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
      .then(function (json) {
        var cur = json.current || {};
        if (typeof cur.temperature_2m !== 'number') return Promise.reject();
        var w = match(cur.weather_code, cur.is_day !== 0);
        var data = { icon: w.icon, text: w.text, tone: w.tone, temp: cur.temperature_2m, city: city };
        apply(data);
        save(data);
      })
      .catch(function () {
        if (city !== FALLBACK.label) request(FALLBACK.lat, FALLBACK.lon, FALLBACK.label);
        else {
          summaryEl.textContent = '天气暂不可用';
        }
      });
  }

  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(
      function (pos) {
        request(pos.coords.latitude.toFixed(3), pos.coords.longitude.toFixed(3), '你的位置');
      },
      function () { request(FALLBACK.lat, FALLBACK.lon, FALLBACK.label); },
      { timeout: 6000, maximumAge: 30 * 60 * 1000, enableHighAccuracy: false }
    );
  } else {
    request(FALLBACK.lat, FALLBACK.lon, FALLBACK.label);
  }
})();
</script>

<style>
  /* 完全照搬参考站 #nav-weather / .weather-capsule */
  .mw-root {
    --weather-tone-a: #6aa9ff;
    --weather-tone-b: #2f5d9e;
    display: flex; align-items: center;
    position: fixed; left: 20px; bottom: 76px; z-index: 20;
    width: fit-content; max-width: calc(100vw - 40px);
    overflow: hidden; isolation: isolate; cursor: pointer;
    border-radius: 40px; transform-origin: left bottom;
    transition: box-shadow .3s, opacity .3s, transform .4s cubic-bezier(.34, 1.56, .64, 1);
    box-shadow: var(--efu-shadow-border);
  }
  .mw-root[data-weather="sun"]   { --weather-tone-a: #ffc13b; --weather-tone-b: #ef8a1b; }
  .mw-root[data-weather="cloud"] { --weather-tone-a: #9aa7bd; --weather-tone-b: #56657e; }
  .mw-root[data-weather="rain"]  { --weather-tone-a: #6aa9ff; --weather-tone-b: #2f5d9e; }
  .mw-root[data-weather="snow"]  { --weather-tone-a: #b6d2ec; --weather-tone-b: #6f8fb5; }
  .mw-root[data-weather="fog"]   { --weather-tone-a: #a9aebc; --weather-tone-b: #6d7280; }
  .mw-root[data-weather="night"] { --weather-tone-a: #5a6cae; --weather-tone-b: #22305a; }
  .weather-capsule {
    display: flex; align-items: center; justify-content: flex-start;
    position: relative; width: 46px; min-width: 46px; max-width: none;
    height: 46px; padding: 0 11px; overflow: hidden;
    color: var(--efu-fontcolor);
    background: linear-gradient(to bottom, var(--efu-maskbg), var(--efu-maskbgdeep));
    border: var(--style-border); border-radius: 40px;
    box-shadow: var(--efu-shadow-glass-inset);
    backdrop-filter: var(--glass-blur, saturate(180%) blur(20px));
    -webkit-backdrop-filter: var(--glass-blur, saturate(180%) blur(20px));
    transform: translateZ(0);
    transition: width .44s cubic-bezier(.22, 1, .36, 1), box-shadow .3s, color .28s, border-color .28s;
  }
  .weather-capsule::after {
    content: ''; position: absolute; inset: 0; z-index: 0;
    border-radius: inherit; opacity: 0; pointer-events: none;
    background: linear-gradient(135deg, var(--weather-tone-a), var(--weather-tone-b));
    transition: opacity .32s ease;
  }
  .weather-capsule :global(.weather-icon) {
    position: relative; z-index: 1; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    width: 24px; height: 24px; font-size: 18px;
    color: var(--weather-tone-a); transition: color .28s;
  }
  .weather-capsule :global(.weather-summary) {
    position: relative; z-index: 1; flex-shrink: 0; display: inline-block;
    width: auto; max-width: 0; margin-left: 0; opacity: 0;
    color: var(--efu-white); font-size: 14px; font-weight: 500;
    white-space: nowrap; overflow: hidden;
    transition: max-width .44s cubic-bezier(.22, 1, .36, 1), margin .44s cubic-bezier(.22, 1, .36, 1), opacity .3s ease 80ms;
  }
  .weather-capsule:hover { width: max-content; color: var(--efu-white); border-color: var(--efu-card-border); }
  .weather-capsule:hover::after { opacity: 1; }
  .weather-capsule:hover :global(.weather-icon) { color: var(--efu-white); }
  .weather-capsule:hover :global(.weather-summary) { max-width: 300px; margin-left: 10px; opacity: 1; }
  @media (max-width: 600px) {
    .mw-root { left: 12px; bottom: 66px; }
  }
</style>
