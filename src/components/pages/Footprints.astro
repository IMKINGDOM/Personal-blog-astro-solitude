---
import { url } from '../../lib/site';
---

<div class="footprints-page">
  <header class="fp-hero">
    <h1 class="fp-title">步履鸿迹</h1>
    <p class="fp-desc">一路山河远阔 四海星光偕行</p>
  </header>

  <div class="fp-map-wrap">
    <div id="fp-map" class="fp-map"></div>
    <div id="fp-map-tip" class="fp-map-tip">地图加载中…</div>
  </div>

  <div class="fp-list-panel">
    <div class="fp-list-head">
      <h2>已点亮的城市</h2>
      <div id="fp-stats" class="fp-stats"></div>
    </div>
    <ul id="fp-list" class="fp-list"></ul>
    <p id="fp-empty" class="fp-empty">还没有足迹。</p>
  </div>
</div>

<style>
  .footprints-page { max-width: 1200px; margin: 0 auto; padding: 10px 16px 50px; color: var(--efu-fontcolor); }
  .fp-hero { text-align: center; margin: 10px 0 26px; }
  .fp-title { color: var(--efu-fontcolor); font-size: 42px; margin: 0 0 12px; letter-spacing: .08em; }
  .fp-desc { color: var(--efu-secondtext); font-size: 15px; margin: 0; }
  .fp-desc strong { color: var(--efu-theme); font-size: 18px; }
  .fp-map-wrap {
    position: relative; height: 520px; border-radius: 14px; overflow: hidden;
    border: 1px solid var(--efu-theme); background: var(--efu-card-bg);
  }
  .fp-map { width: 100%; height: 100%; }
  .fp-map-tip[hidden] { display: none; }
  .fp-map-tip {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    color: var(--efu-secondtext); font-size: 14px; pointer-events: none;
  }
  .fp-list-panel { margin-top: 26px; }
  .fp-list-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
  .fp-list-head h2 { color: var(--efu-theme); font-size: 18px; margin: 0 0 12px; }
  .fp-stats { display: flex; gap: 14px; margin-bottom: 12px; font-size: 13px; color: var(--efu-secondtext); }
  .fp-stats b { color: var(--efu-theme); font-size: 16px; font-weight: 800; margin-right: 2px; }
  .fp-list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px;
  }
  :global(.fp-chip) {
    display: flex; align-items: center; justify-content: center;
    width: 100%; min-width: 0; padding: 6px 8px; border-radius: 999px;
    background: var(--efu-theme); color: var(--efu-background);
    font-size: 9px; font-weight: 700; letter-spacing: 0;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--efu-theme) 26%, transparent);
    transition: transform .16s ease, filter .16s ease;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  :global(.fp-chip):hover { transform: translateY(-2px); filter: brightness(1.06); }
  .fp-empty { color: var(--efu-secondtext); font-size: 13px; text-align: center; padding: 18px 0; }
  @media (max-width: 900px) {
    .fp-list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .fp-title { font-size: 32px; }
    .fp-map-wrap { height: 400px; }
    .fp-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    :global(.fp-chip) { font-size: 8px; padding: 6px; }
  }
</style>

<script is:inline src={url('/js/footprint/echarts.min.js')}></script>
