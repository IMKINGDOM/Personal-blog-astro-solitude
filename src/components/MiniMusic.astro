---

<div id="mini-music" class="mm-root" transition:persist="mini-music">
  <div id="mm-bar" class="mm-bar" role="button" tabindex="0" aria-label="音乐播放器">
    <span class="mm-disc">
      <svg class="mm-headphones" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 18a3 3 0 0 1 -2.824 2.995l-.176 .005h-1a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-3a3 3 0 0 1 2.824 -2.995l.176 -.005h1c.351 0 .688 .06 1 .171v-.171a7 7 0 0 0 -13.996 -.24l-.004 .24v.17c.25 -.088 .516 -.144 .791 -.163l.209 -.007h1a3 3 0 0 1 2.995 2.824l.005 .176v3a3 3 0 0 1 -2.824 2.995l-.176 .005h-1a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-6a9 9 0 0 1 17.996 -.265l.004 .265v6z" /></svg>
    </span>
    <span class="mm-track">
      <span id="mm-title" class="mm-title">加载中…</span>
      <span id="mm-artist" class="mm-artist">—</span>
    </span>
    <span class="mm-ctrl">
      <button id="mm-prev" class="mm-icon" type="button" aria-label="上一首"><i class="solitude fas fa-backward-step"></i></button>
      <button id="mm-play" class="mm-icon" type="button" aria-label="播放/暂停"><i class="solitude fas fa-pause"></i></button>
      <button id="mm-next" class="mm-icon" type="button" aria-label="下一首"><i class="solitude fas fa-forward-step"></i></button>
    </span>
    <span id="mm-lyric" class="mm-lyric">♪</span>
  </div>
</div>

<script is:inline define:vars={{ tracks, BASE }}>
(function () {
  var root = document.getElementById('mini-music');
  if (!root || root.dataset.mmInit) return;
  root.dataset.mmInit = '1';

  var bar = document.getElementById('mm-bar');
  var titleEl = document.getElementById('mm-title');
  var artistEl = document.getElementById('mm-artist');
  var lyricEl = document.getElementById('mm-lyric');
  var playBtn = document.getElementById('mm-play');
  var audio = new Audio();
  audio.preload = 'metadata';
  audio.volume = 0.7;

  // 随机顺序
  var order = tracks.map(function (_, i) { return i; });
  for (var j = order.length - 1; j > 0; j--) {
    var k = Math.floor(Math.random() * (j + 1));
    var tmp = order[j]; order[j] = order[k]; order[k] = tmp;
  }
  var pos = 0;

  function currentLyrics() { return tracks[order[pos]].lrc; }
  var lastLine = -1;
  function showLyric(time, force) {
    var lrc = currentLyrics();
    var cur = 0;
    for (var i = 0; i < lrc.length; i++) { if (lrc[i][0] <= time) cur = i; else break; }
    var text = lrc[cur] ? lrc[cur][1] : '♪';
    // 仅行变化时更新文本并重播平滑上移，避免闪烁
    if (cur !== lastLine || force) {
      lastLine = cur;
      lyricEl.textContent = text;
      lyricEl.classList.remove('slide');
      void lyricEl.offsetWidth;
      lyricEl.classList.add('slide');
    }
  }
  var pendingStart = null;
  function tryPlay() {
    return audio.play().catch(function () {
      // 浏览器策略：首次用户交互前禁止自动播放。注册一次性启动。
      if (pendingStart) return;
      pendingStart = function () {
        audio.play().catch(function () {});
        document.removeEventListener('pointerdown', pendingStart);
        document.removeEventListener('keydown', pendingStart);
        pendingStart = null;
      };
      document.addEventListener('pointerdown', pendingStart);
      document.addEventListener('keydown', pendingStart);
    });
  }
  function load(n, autoplay) {
    pos = (n + order.length) % order.length;
    var track = tracks[order[pos]];
    audio.src = BASE + track.file;
    titleEl.textContent = track.name;
    artistEl.textContent = track.artist;
    showLyric(0, true);
    if (autoplay !== false) tryPlay();
  }

  audio.addEventListener('timeupdate', function () { showLyric(audio.currentTime); });
  audio.addEventListener('ended', function () {
    // 页面切换会中断音频流并触发 ended；只有真正播放到结尾才切下一首
    if (audio.duration && audio.currentTime >= audio.duration - 1.5) load(pos + 1);
  });
  audio.addEventListener('play', function () { playBtn.innerHTML = '<i class="solitude fas fa-pause"></i>'; root.classList.add('is-playing'); });
  audio.addEventListener('pause', function () {
    // 切歌时浏览器会抛 pause，但随后立刻 play；用延时避免状态抖动
    setTimeout(function () {
      if (audio.paused) {
        playBtn.innerHTML = '<i class="solitude fas fa-play"></i>';
        root.classList.remove('is-playing');
      }
    }, 120);
  });

  playBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    // pointerdown 的 pendingStart 可能已启动播放，避免同一手势里立刻暂停
    if (audio.paused) tryPlay();
    else if (!pendingStart) audio.pause();
  });
  document.getElementById('mm-next').addEventListener('click', function (e) { e.stopPropagation(); load(pos + 1); });
  document.getElementById('mm-prev').addEventListener('click', function (e) { e.stopPropagation(); load(pos - 1); });

  // 拖拽
  var down = false, moved = false, sx = 0, sy = 0, ox = 0, oy = 0;
  bar.addEventListener('pointerdown', function (e) {
    if (e.target.closest('.mm-icon')) return;
    down = true; moved = false;
    sx = e.clientX; sy = e.clientY;
    var r = root.getBoundingClientRect();
    ox = r.left; oy = r.top;
    root.style.left = ox + 'px'; root.style.top = oy + 'px';
    root.style.bottom = 'auto';
    bar.setPointerCapture(e.pointerId);
  });
  bar.addEventListener('pointermove', function (e) {
    if (!down) return;
    var dx = e.clientX - sx, dy = e.clientY - sy;
    if (Math.abs(dx) > 4 || Math.abs(dy) > 4) moved = true;
    root.style.left = Math.max(0, Math.min(window.innerWidth - root.offsetWidth, ox + dx)) + 'px';
    root.style.top = Math.max(0, Math.min(window.innerHeight - root.offsetHeight, oy + dy)) + 'px';
  });
  bar.addEventListener('pointerup', function (e) {
    down = false;
    bar.releasePointerCapture(e.pointerId);
    setTimeout(function () { moved = false; }, 0);
  });

  load(0);
})();
</script>

<style>
  .mm-root {
    position: fixed; left: 18px; bottom: 18px; z-index: 9000;
    font-family: inherit; color: var(--efu-fontcolor);
  }
  .mm-bar {
    display: flex; align-items: center; gap: 0;
    height: 38px; padding: 3px;
    border-radius: 999px; border: 1px solid var(--efu-theme);
    background: color-mix(in srgb, var(--efu-card-bg) 78%, transparent);
    color: var(--efu-fontcolor);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: 0 3px 12px rgba(0,0,0,.25);
    cursor: grab; white-space: nowrap; overflow: hidden;
    transition: box-shadow .25s ease;
    touch-action: none;
  }
  .mm-bar:hover { box-shadow: 0 4px 18px rgba(0,0,0,.38); }
  .mm-bar:active { cursor: grabbing; }
  /* 音符圆与胶囊左端外圈同心：尺寸贴近胶囊内高、零左内边距 */
  .mm-disc {
    flex: 0 0 30px; width: 30px; height: 30px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; line-height: 1;
    background: var(--efu-theme); color: var(--efu-background);
  }
  .mm-headphones { display: block; }
  .mm-root.is-playing .mm-headphones { animation: mm-spin 4s linear infinite; }
  @keyframes mm-spin { to { transform: rotate(360deg); } }
  .mm-ctrl, .mm-track, .mm-lyric {
    max-width: 0; opacity: 0; overflow: hidden;
    transition: max-width .35s ease, opacity .25s ease, margin .35s ease;
  }
  .mm-bar:hover .mm-track { max-width: 150px; opacity: 1; margin-left: 8px; }
  .mm-bar:hover .mm-ctrl { max-width: 90px; opacity: 1; margin-left: 6px; }
  .mm-bar:hover .mm-lyric { max-width: 260px; opacity: 1; margin-left: 8px; }
  .mm-track { display: flex; flex-direction: column; line-height: 1.2; }
  .mm-title { font-size: 12px; font-weight: 700; }
  .mm-artist { font-size: 10px; color: var(--efu-secondtext); }
  .mm-ctrl { display: flex; gap: 1px; flex: 0 0 auto; }
  .mm-icon {
    width: 26px; height: 26px; flex: 0 0 26px;
    border: none; border-radius: 6px; cursor: pointer;
    background: transparent; color: var(--efu-theme); font-size: 12px;
  }
  .mm-icon:hover { filter: brightness(1.25); }
  /* 歌词：纯文本主题色显示，行切换平滑上移 */
  .mm-lyric {
    font-size: 12px; display: block; overflow: hidden;
    height: 18px; line-height: 18px; color: var(--efu-fontcolor);
    padding-right: 0;
    transition: max-width .35s ease, opacity .25s ease, margin .35s ease, padding-right .35s ease;
  }
  .mm-bar:hover .mm-lyric { padding-right: 7px; }
  .mm-lyric.slide { animation: mm-lyric-slide .32s cubic-bezier(.22,.8,.3,1); }
  @keyframes mm-lyric-slide {
    from { transform: translateY(12px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  @media (max-width: 600px) {
    .mm-bar:hover .mm-lyric { max-width: 140px; }
  }
</style>
